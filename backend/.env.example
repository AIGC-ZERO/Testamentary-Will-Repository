# 岛城遗嘱库 · 后端环境变量模板
DATABASE_URL="postgresql://will:will_dev_password@127.0.0.1:5432/will_repository?schema=public"
JWT_SECRET="change-me-in-production"
# H5 用户令牌有效期
JWT_EXPIRES_IN="7d"
# 后台令牌有效期（短寿命，降低泄露滥用窗口）
JWT_ADMIN_EXPIRES_IN="2h"
PORT=3000
CORS_ORIGIN="http://127.0.0.1:5173"
# 运行环境：production 时 SMS_DEV_CODE 自动失效（即使已配置）
NODE_ENV="development"
# 开发环境固定验证码（仅 NODE_ENV != production 时生效；生产必须走真实短信通道）
SMS_DEV_CODE="888888"
